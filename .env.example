# focuspin backend — переменные окружения.
# Окна лимитов: минута / час / день (день — UTC).
# ВСЕ LIMIT_* и GLOBAL_* обязательны: в коде дефолтов нет, сервер не стартует
# без явных значений. Числа ниже — стартовый пример, подберите под свой деплой.

APP_ENV=production            # development | test | production
PORT=8080
DATABASE_PATH=./data/focuspin.db
LOG_LEVEL=info                # debug | info | warn | error

# Секрет для HMAC-хеширования идентификаторов (device id, ip) перед записью в БД.
# В production обязателен, >= 32 символов. Смена сбрасывает историю лимитов (делать off-peak).
HMAC_SECRET=<openssl rand -hex 32>

# Доверять X-Forwarded-For (включать ТОЛЬКО за своим реверс-прокси: Caddy/Cloudflare).
TRUST_PROXY=false

# Upstream (DeepSeek, OpenAI-совместимый).
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=<ключ DeepSeek>
DEEPSEEK_MODEL=deepseek-flash
UPSTREAM_TIMEOUT_MS=40000     # один вызов upstream; приложение ждёт 45 c
REQUEST_BUDGET_MS=42000       # общий бюджет запроса включая ретраи
CORRECTIVE_RETRY=true         # один повтор с подсказкой формата при невалидном JSON модели

# Габариты запроса.
MAX_BODY_BYTES=65536
MAX_SYSTEM_CHARS=8000         # системный промпт приложения ~3.8k символов
MAX_USER_CHARS=48000          # до 150 задач контекста + запрос

# Глобальные предохранители (весь сервер).
GLOBAL_MAX_INFLIGHT=8         # одновременных вызовов upstream; сверх — 429 busy
GLOBAL_DAILY_REQUEST_CAP=20000
GLOBAL_DAILY_TOKEN_CAP=25000000

# Ярус: IP-адрес клиента.
LIMIT_IP_MINUTE=15
LIMIT_IP_HOUR=60
LIMIT_IP_DAY=300
LIMIT_SUBNET_DAY=1200         # /24 (IPv4) или /64 (IPv6) — ботнет из одной сети
LIMIT_IP_DISTINCT_DEVICES_DAY=6  # ротация device id с одного IP за день

# Ярус: устройство (device id из Bearer).
LIMIT_DEVICE_MINUTE=6
LIMIT_DEVICE_HOUR=15
LIMIT_DEVICE_DAY=50
LIMIT_FRESH_DEVICE_HOURS=24   # устройство младше — считается «свежим»
LIMIT_FRESH_DEVICE_DAY=15     # пониженный дневной лимит свежих устройств (цена ротации)

# Антиабьюз: подряд идущие contract_violation от одного устройства за час.
LIMIT_CONTRACT_FAILS_PER_HOUR=10
